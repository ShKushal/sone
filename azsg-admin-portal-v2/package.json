{
  "name": "azg-admin-portal",
  "version": "1.0.0",
  "private": true,
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.6",
    "aws-amplify": "^6.22.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "react-scripts": "5.0.1"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",

    "start:scc-preprod": "env-cmd -f .env.scc.preprod react-scripts start",
    "start:scc-prod": "env-cmd -f .env.scc.prod react-scripts start",
    "start:sccplus-nonprod": "env-cmd -f .env.sccplus.nonprod react-scripts start",
    "start:sccplus-prod": "env-cmd -f .env.sccplus.prod react-scripts start",

    "build:scc-preprod": "env-cmd -f .env.scc.preprod react-scripts build",
    "build:scc-prod": "env-cmd -f .env.scc.prod react-scripts build",
    "build:sccplus-nonprod": "env-cmd -f .env.sccplus.nonprod react-scripts build",
    "build:sccplus-prod": "env-cmd -f .env.sccplus.prod react-scripts build"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version"
    ]
  },
  "devDependencies": {
    "env-cmd": "^11.0.0"
  }
}
