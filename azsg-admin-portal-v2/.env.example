# Please fill the variables below (copy this file to .env first: cp .env.example .env)
REACT_APP_REGION=ap-southeast-1
REACT_APP_API_URL=https://your-api-id.execute-api.ap-southeast-1.amazonaws.com

# Employee sign-in: Microsoft Entra ID app registration
REACT_APP_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
REACT_APP_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
